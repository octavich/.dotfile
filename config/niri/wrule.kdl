blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}


layer-rule {
    match namespace="^launcher$"

    background-effect {
        blur true
	xray false
    }
}
window-rule {
    match app-id="Nautilus"

    popups {
        geometry-corner-radius 15
        opacity 0.8

        background-effect {
            blur true
        }
    }
}
window-rule {
    match app-id="Spotify"
        opacity 0.9

        background-effect {
            blur true
    }
}
window-rule {
    match app-id="dms:bar"
    match app-id="quickshell"
    match app-id="dms"

        background-effect {
            blur true
	    xray false
    }
}


layer-rule {
    match namespace="waybar"
    match at-startup=true
    opacity 0.9999
}

layer-rule {
    match namespace="quickshell"
    match namespace="noctalia-wallpaper-eDP-1"
    match namespace="noctalia-wallpaper-HDMI-A-1"
    place-within-backdrop true
}
overview {
	    workspace-shadow {
        off
	}
		backdrop-color "#161616"
	 	zoom 0.25
}
window-rule {
    		geometry-corner-radius 12
    		clip-to-geometry true
	}

window-rule {
    		match is-window-cast-target=true
    		tab-indicator {
        	active-color "#f38ba8"
        	inactive-color "#7d0d2d"
    		}
}
window-rule {
    		match app-id="zen" title="^Картинка в картинке$"
		match title="^Picture-in-Picture$"
    		open-floating true
    		default-floating-position x=32 y=32 relative-to="top-right"
    		open-focused false
	}
window-rule{
    		match app-id="zen$"
		match app-id="discord"
		match app-id="equibop"
		match app-id="Spotify"
    		open-maximized true
	}
window-rule {
		//match app-id="io.github.kukuruzka165.materialgram"
		match app-id="app.zen_browser.zen"
		block-out-from "screencast"
	}
window-rule {
    match is-window-cast-target=true
    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
    border {
        active-color "#7d0d2d"
	inactive-color "#7d0d2d"
    }
    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

window-rule {
		match app-id="org.gnome.NautilusPreviewer"
		open-floating true
}
window-rule {
    		match app-id="thinkfan-ui"
		match app-id="org.kde.kdeconnect.daemon"
		match app-id="org.gnome.Calculator"
            	default-column-width { fixed 550; }
    		default-window-height { fixed 300; }
    		open-floating true
	}

animations {
	workspace-switch {
    spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
  }
  window-open {
    duration-ms 150
    curve "ease-out-quad"
  }
  window-close {
    duration-ms 150
    curve "ease-out-quad"
  }
   horizontal-view-movement {
    spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
  }
  window-movement {
    spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
  }
  config-notification-open-close {
    spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
  }
  exit-confirmation-open-close {
    spring damping-ratio=0.6 stiffness=500 epsilon=0.01
  }
}
	workspace "1" {
		open-on-output "HDMI-A-1"
	}
	workspace "2" {
		open-on-output "HDMI-A-1"
	}
	workspace "3" {
		open-on-output "HDMI-A-1"
	}
	workspace "4" {
		open-on-output "HDMI-A-1"
	}
	workspace "5" {
		open-on-output "HDMI-A-1"
	}

